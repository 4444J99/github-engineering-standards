            "NOT_REQUIRED_WITH_REASON"
          ]
        },
        "attribution_rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        }
      },
      "required": [
        "scope",
        "obligations",
        "valid_until",
        "use",
        "attribution_disposition",
        "attribution_rationale"
      ]
    },
    "inventoryAssurances": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all_candidate_outputs_accounted_for": {
          "const": true
        },
        "all_upstream_uses_accounted_for": {
          "const": true
        },
        "source_use_classifications_reviewed": {
          "const": true
        },
        "no_upstream_expression_confirmed": {
          "type": "boolean"
