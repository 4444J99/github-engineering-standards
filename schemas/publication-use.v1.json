        "disposition"
      ]
    },
    "useSubject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
