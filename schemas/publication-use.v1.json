    "inventoryAttestation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "ges.publication-use-attestation.v1"
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "const": "APPROVED_FOR_SPECIFIED_USE"
