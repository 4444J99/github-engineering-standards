        "reviewed_at",
        "decision",
        "unresolved",
        "rationale",
        "kind",
        "subject",
        "assurances"
      ]
    },
    "useAttestation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "ges.publication-use-attestation.v1"
        },
        "identity": {
          "type": "string",
          "minLength": 1,
