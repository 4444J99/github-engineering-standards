        },
        "decision": {
          "const": "APPROVED_FOR_SPECIFIED_USE"
        },
        "unresolved": {
          "type": "array",
          "maxItems": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "kind": {
          "enum": [
            "expression_rights_review",
            "independent_exception_audit",
            "human_acceptance",
            "distribution_approval"
          ]
        },
        "subject": {
          "$ref": "#/$defs/useSubject"
        },
        "assurances": {
          "$ref": "#/$defs/useAssurances"
        }
      },
      "required": [
        "schema",
        "identity",
        "reviewed_at",
        "decision",
        "unresolved",
        "rationale",
        "kind",
        "subject",
        "assurances"
      ]
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
