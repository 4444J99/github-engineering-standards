{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ges:source-charter:v1",
  "title": "ges.source-charter.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ges.source-charter.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^source-charter:[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[\\w.-]+/[\\w.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "repository",
        "commit"
      ],
      "additionalProperties": false
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "authoritative_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "non_authoritative_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "artifact_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "root_citations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PROPOSED",
            "REVIEWED"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "reviewer",
        "evidence_reference"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "source",
    "purpose",
    "audience",
    "authoritative_domains",
    "non_authoritative_domains",
    "artifact_roles",
    "root_citations",
    "review"
  ],
  "additionalProperties": false
}
