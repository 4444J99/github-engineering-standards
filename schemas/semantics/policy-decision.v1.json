{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ges:policy-decision:v1",
  "title": "ges.policy-decision.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ges.policy-decision.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^policy-decision:[a-f0-9]{64}$"
    },
    "reconciliation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "ADOPT",
        "REJECT"
      ]
    },
    "obligation": {
      "type": "string",
      "enum": [
        "MUST",
        "SHOULD",
        "MAY",
        "NONE"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "control_references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "implementation_bindings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "owner_approval": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PROPOSED",
            "REVIEWED"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "reviewer",
        "evidence_reference"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "reconciliation_ids",
    "decision",
    "obligation",
    "scope",
    "applicability",
    "parameters",
    "exceptions",
    "profiles",
    "control_references",
    "implementation_bindings",
    "rationale",
    "owner_approval"
  ],
  "additionalProperties": false
}
