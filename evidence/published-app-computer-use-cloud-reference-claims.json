  "claims": [
    {
      "id": "PUB-COMPUTER-APP-CLOUD-001",
      "span": "line-3",
      "statement": "The app can request control of local desktop applications."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-002",
      "span": "line-6",
      "statement": "The acquired how-to identifies computer use as public preview with changeable behavior."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-003",
      "span": "line-10",
      "statement": "App computer use can inspect accessible content and visual context."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-004",
      "span": "line-10",
      "statement": "App computer use can click application controls."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-005",
      "span": "line-10",
      "statement": "App computer use can enter or edit text."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-006",
      "span": "line-10",
      "statement": "App computer use can press keys."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-007",
      "span": "line-10",
      "statement": "App computer use can scroll or drag."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-008",
      "span": "line-10",
      "statement": "App computer use can traverse workflows involving multiple applications."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-009",
      "span": "line-12",
      "statement": "The documented scope is local sessions on macOS and Windows."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-010",
      "span": "line-12",
      "statement": "Legacy or GUI-only tools without an API, CLI or MCP interface are an intended target."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-011",
      "span": "line-14",
      "statement": "The concept link uses the acquired body's version-specific path, without proving a pinned source revision."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-012",
      "span": "line-18",
      "statement": "The documented settings-based enablement starts by opening app settings."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-013",
      "span": "line-19",
      "statement": "The user is directed to the Computer Use settings section."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-014",
      "span": "line-20",
      "statement": "The enablement toggle activates the feature."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-015",
      "span": "line-22",
      "statement": "macOS Accessibility permission is a prerequisite for control interaction."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-016",
      "span": "line-23",
      "statement": "macOS Screen Recording permission is a prerequisite for inspecting window visuals."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-017",
      "span": "line-24",
      "statement": "The settings offer another prerequisite check if a macOS permission change was not detected."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-018",
      "span": "line-26",
      "statement": "A session command provides an alternative enablement path; its documentation was not executed."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-019",
      "span": "line-26",
      "statement": "A separate session command reports plugin and MCP status; it was not executed."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-020",
      "span": "line-30",
      "statement": "Requests should state the desired outcome."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-021",
      "span": "line-30",
      "statement": "Requests should identify the involved applications."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-022",
      "span": "line-30",
      "statement": "Requests should state important limits."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-023",
      "span": "line-35",
      "statement": "The example asks for observation and summarization of an installed application's status, not an unconstrained automation grant."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-024",
      "span": "line-36",
      "statement": "The example explicitly prohibits changing values."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-025",
      "span": "line-36",
      "statement": "The example explicitly prohibits submitting forms."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-026",
      "span": "line-39",
      "statement": "The example's application placeholder must correspond to an application installed on the user's computer."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-027",
      "span": "line-41",
      "statement": "The app's Tool Permissions setting determines whether approval is requested."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-028",
      "span": "line-41",
      "statement": "Permission settings can be inspected or changed through the Sessions settings section."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-029",
      "span": "line-41",
      "statement": "When approval is requested, the user should verify the target application matches the request."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-030",
      "span": "line-41",
      "statement": "When approval is requested, the user should verify the intended action matches the request."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-031",
      "span": "line-41",
      "statement": "A one-session approval grants access only for the current computer-use session."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-032",
      "span": "line-41",
      "statement": "Persistent approval saves authorization for later sessions."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-033",
      "span": "line-41",
      "statement": "The user can decline or cancel a permission request."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-034",
      "span": "line-43",
      "statement": "Stop or Escape interrupts the active operation."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-035",
      "span": "line-47",
      "statement": "Saved approval is shared between the app and CLI on the same computer."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-036",
      "span": "line-51",
      "statement": "The Computer Use settings list permits deletion of a particular saved application approval."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-037",
      "span": "line-53",
      "statement": "Deleting a saved approval removes future-session permission on both surfaces."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-038",
      "span": "line-53",
      "statement": "Deleting a saved approval does not revoke permission already granted in an active session."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-039",
      "span": "line-53",
      "statement": "Stopping the current operation is separate from removing future approval."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-040",
      "span": "line-53",
      "statement": "Ending the session revokes application access granted to that session."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-041",
      "span": "line-57",
      "statement": "The feature can be disabled through its settings toggle."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-042",
      "span": "line-59",
      "statement": "A session command also disables computer use; it was inspected rather than executed."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-043",
      "span": "line-63",
      "statement": "A missing settings page should prompt a check of account feature availability."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-044",
      "span": "line-63",
      "statement": "A missing settings page should prompt a check of operating-system feature availability."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-045",
      "span": "line-64",
      "statement": "Failed macOS application interaction should prompt confirmation that Accessibility is granted."
    },
    {
      "id": "PUB-COMPUTER-APP-CLOUD-046",
      "span": "line-64",
      "statement": "Failed macOS application interaction should prompt confirmation that Screen Recording is granted."
    }
  ]
