  "claims": [
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-001",
      "span": "line-3",
      "statement": "Workflows can coordinate deterministic operations, agents, tools, service calls and human interaction."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-002",
      "span": "line-5",
      "statement": "The feature is described as changeable public preview."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-003",
      "span": "line-7",
      "statement": "The how-to link retains this acquired body's version-qualified path."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-004",
      "span": "line-11",
      "statement": "A workflow is a program defining a task's process."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-005",
      "span": "line-11",
      "statement": "Automated steps can be combined with one or more agents."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-006",
      "span": "line-11",
      "statement": "Execution can be sequential."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-007",
      "span": "line-11",
      "statement": "Execution can be parallel."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-008",
      "span": "line-13",
      "statement": "Reusable multi-stage investigations are an intended use case; the incident example gathers telemetry, divides analysis and combines structured findings."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-009",
      "span": "line-17",
      "statement": "Workflow steps can invoke commands."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-010",
      "span": "line-17",
      "statement": "Workflow steps can invoke tools."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-011",
      "span": "line-17",
      "statement": "Workflow steps can call services."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-012",
      "span": "line-18",
      "statement": "Independent subtasks can run concurrently."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-013",
      "span": "line-19",
      "statement": "Stage results can be passed onward."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-014",
      "span": "line-20",
      "statement": "Subagents can assess each other's findings."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-015",
      "span": "line-21",
      "statement": "Results can be combined into one response."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-016",
      "span": "line-22",
      "statement": "Human-input requests depend on support in the client application."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-017",
      "span": "line-23",
      "statement": "Review checkpoints can pause execution until the user resumes."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-018",
      "span": "line-25",
      "statement": "Workflow code defines stage boundaries and agent involvement."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-019",
      "span": "line-25",
      "statement": "Agents perform analysis and judgment within the coded process."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-020",
      "span": "line-27",
      "statement": "Requested structured output can be checked and an agent asked to correct its format."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-021",
      "span": "line-29",
      "statement": "Definitions are implemented through Copilot extensions."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-022",
      "span": "line-31",
      "statement": "Copilot can author a definition from a requested task and process."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-023",
      "span": "line-32",
      "statement": "Users can write definitions with authoring guidance."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-024",
      "span": "line-33",
      "statement": "Shared workflows become available after their extension is loaded."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-025",
      "span": "line-35",
      "statement": "A natural-language request can select a workflow by name."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-026",
      "span": "line-41",
      "statement": "Prompt-started workflows run in the background."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-027",
      "span": "line-41",
      "statement": "The user can continue other session work during that execution."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-028",
      "span": "line-41",
      "statement": "Completion is reported to the session."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-029",
      "span": "line-44",
      "statement": "The chat agent requires an explicit request or a skill/slash-command instruction to create or launch a workflow."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-030",
      "span": "line-46",
      "statement": "A dedicated CLI command starts an existing workflow without an interactive chat request."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-031",
      "span": "line-48",
      "statement": "The terminal invocation waits until execution completes or stops."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-032",
      "span": "line-48",
      "statement": "The terminal path supports repeated inputs, result capture and script integration."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-033",
      "span": "line-50",
      "statement": "An extension may provide a slash command, custom tool, hook or SDK entry point."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-034",
      "span": "line-50",
      "statement": "App extensions may provide canvas launch controls, subject to extension and client support."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-035",
      "span": "line-52",
      "statement": "Canvas documentation is linked with this body's version path, not certified as fully reviewed."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-036",
      "span": "line-54",
      "statement": "The user can request an inventory of available definitions."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-037",
      "span": "line-64",
      "statement": "Autopilot emphasizes sustained agent autonomy rather than a fixed authored process."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-038",
      "span": "line-65",
      "statement": "Fleet encourages delegation whose task decomposition is chosen by the agent for each run."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-039",
      "span": "line-66",
      "statement": "Dynamic-workflow steps, conditions and handoffs are defined by its author."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-040",
      "span": "line-68",
      "statement": "Reusing code does not guarantee identical execution paths or agent answers."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-041",
      "span": "line-80",
      "statement": "Reusable processes and tasks needing explicit stages, checks or limits are recommended candidates."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-042",
      "span": "line-82",
      "statement": "Release assessment with a human review pause is an example."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-043",
      "span": "line-83",
      "statement": "Parallel review of changed pull-request files is an example."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-044",
      "span": "line-84",
      "statement": "A two-model agreement rule for unresolved comments is an example-specific reporting condition, not independent correctness proof."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-045",
      "span": "line-85",
      "statement": "Cross-directory pattern searches are an example."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-046",
      "span": "line-86",
      "statement": "Research, planning and implementation can form successive stages."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-047",
      "span": "line-87",
      "statement": "Long or costly jobs with pause/resume needs are an example."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-048",
      "span": "line-89",
      "statement": "Ordinary chat is generally sufficient for a quick answer or simple edit."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-049",
      "span": "line-93",
      "statement": "Workflow subagents inherit permission grants from the initiating CLI session."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-050",
      "span": "line-95",
      "statement": "An unapproved action produces the normal interactive permission request."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-051",
      "span": "line-95",
      "statement": "The requesting subagent waits for the user's decision."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-052",
      "span": "line-97",
      "statement": "A session-wide grant for one subagent also applies to others requiring that permission."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-053",
      "span": "line-99",
      "statement": "The noninteractive workflow command does not show approval prompts."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-054",
      "span": "line-99",
      "statement": "Required agent permissions must be granted before a command-line launch."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-055",
      "span": "line-101",
      "statement": "Extension code may execute directly outside the agent permission prompts; those prompts are not a universal sandbox."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-056",
      "span": "line-105",
      "statement": "Interactive authoring starts with a description of the required outcome."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-057",
      "span": "line-107",
      "statement": "The default authored definition is scoped to the current session."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-058",
      "span": "line-107",
      "statement": "A personal or project extension can be requested instead."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-059",
      "span": "line-113",
      "statement": "New definitions should first be tried on a small scope."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-060",
      "span": "line-113",
      "statement": "The result should be evaluated before broader execution."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-061",
      "span": "line-115",
      "statement": "A durable process change should revise the saved definition rather than merely override one run's limit."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-062",
      "span": "line-121",
      "statement": "Definition revisions are saved to the owning extension."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-063",
      "span": "line-121",
      "statement": "New runs use revisions only after the updated extension is loaded."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-064",
      "span": "line-121",
      "statement": "A revision does not replace results already stored for a paused run."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-065",
      "span": "line-123",
      "statement": "Project consumers must obtain updated repository content."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-066",
      "span": "line-123",
      "statement": "Project consumers must reload extensions to use the revision."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-067",
      "span": "line-127",
      "statement": "Personal extension storage makes the definition reusable across sessions."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-068",
      "span": "line-127",
      "statement": "Repository extension storage shares the definition with project collaborators."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-069",
      "span": "line-127",
      "statement": "Sharing a definition does not share the original session's history or progress."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-070",
      "span": "line-129",
      "statement": "Plugin packaging permits wider distribution; publication instructions are not an authorization to publish."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-071",
      "span": "line-135",
      "statement": "A concurrency cap limits simultaneously active workflow-owned agents."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-072",
      "span": "line-136",
      "statement": "A total-agent cap limits the number launched across the whole run."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-073",
      "span": "line-137",
      "statement": "A timeout counts active execution before and after pauses."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-074",
      "span": "line-137",
      "statement": "Paused time is excluded from active execution duration."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-075",
      "span": "line-138",
      "statement": "An AI-credit cap is approximate rather than a strict monetary ceiling."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-076",
      "span": "line-141",
      "statement": "Credit reporting occurs after usage and stops new work at the limit."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-077",
      "span": "line-141",
      "statement": "Already-started work can cause total usage to exceed the credit cap."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-078",
      "span": "line-145",
      "statement": "The starting request can set limits."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-079",
      "span": "line-151",
      "statement": "The workflow code can provide default limits."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-080",
      "span": "line-153",
      "statement": "Personal settings provide fallback limits when the request and workflow omit them."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-081",
      "span": "line-157",
      "statement": "The documented settings contain a concurrency default."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-082",
      "span": "line-158",
      "statement": "The documented settings contain a total-agent default."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-083",
      "span": "line-159",
      "statement": "The documented timeout default is expressed in seconds."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-084",
      "span": "line-160",
      "statement": "The documented settings contain an AI-credit default."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-085",
      "span": "line-168",
      "statement": "Request limits override corresponding code limits."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-086",
      "span": "line-168",
      "statement": "Code limits override corresponding personal defaults."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-087",
      "span": "line-170",
      "statement": "Reaching the concurrency cap queues agents instead of stopping the run."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-088",
      "span": "line-172",
      "statement": "Other limits can stop execution while retaining status and saved outputs."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-089",
      "span": "line-172",
      "statement": "A resumed limit must be increased as a cumulative run total, not reset as a fresh allowance."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-090",
      "span": "line-176",
      "statement": "Large agent fan-out can increase duration and credit consumption."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-091",
      "span": "line-178",
      "statement": "Users should measure a small trial before setting a large-job credit budget."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-092",
      "span": "line-182",
      "statement": "CLI and app provide run-list interfaces for present and past workflows."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-093",
      "span": "line-184",
      "statement": "Reported details include credits and workflow-supplied phases, progress and subagents."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-094",
      "span": "line-184",
      "statement": "The run interface can cancel active execution."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-095",
      "span": "line-184",
      "statement": "The run interface can pause active execution."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-096",
      "span": "line-184",
      "statement": "Extensions can also provide custom progress displays."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-097",
      "span": "line-186",
      "statement": "Paused or limit-stopped runs can reuse saved completed-step results."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-098",
      "span": "line-186",
      "statement": "Unsaved work may be repeated on resumption."
    },
    {
      "id": "PUB-DYNAMIC-CONCEPT-FPT-099",
      "span": "line-188",
      "statement": "The management how-to link retains this acquired body's version-specific path."
    }
  ]
}
