  "claims": [
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-001",
      "span": "line-3",
      "statement": "Desktop automation is intended for tasks without a suitable direct tool."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-002",
      "span": "line-6",
      "statement": "The acquired page identifies computer use as a public preview that may change."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-003",
      "span": "line-10",
      "statement": "The capability can read accessible application content and visual context."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-004",
      "span": "line-10",
      "statement": "The capability can operate application controls."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-005",
      "span": "line-10",
      "statement": "The capability can enter and modify text."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-006",
      "span": "line-10",
      "statement": "The capability can send keyboard input."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-007",
      "span": "line-10",
      "statement": "The capability can scroll and drag interface items."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-008",
      "span": "line-10",
      "statement": "The capability can coordinate workflows across applications."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-009",
      "span": "line-12",
      "statement": "The documented surfaces are Copilot CLI and the Copilot app on macOS and Windows."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-010",
      "span": "line-14",
      "statement": "Legacy and GUI-only software without API, command-line or MCP access is an intended use case."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-011",
      "span": "line-18",
      "statement": "Summarizing information from a legacy desktop application is a documented example."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-012",
      "span": "line-19",
      "statement": "Editing a presentation is a documented example."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-013",
      "span": "line-20",
      "statement": "Entering data in GUI-only software is a documented example."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-014",
      "span": "line-21",
      "statement": "Transferring information across applications is a documented example."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-015",
      "span": "line-24",
      "statement": "A direct API, MCP, terminal, filesystem or dedicated browser tool is generally preferred when it supplies structured and predictable results."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-016",
      "span": "line-30",
      "statement": "Accessible content comes from the operating-system accessibility tree."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-017",
      "span": "line-30",
      "statement": "Screenshots can supply visual context when necessary."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-018",
      "span": "line-36",
      "statement": "The agent selects tools while carrying out the request."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-019",
      "span": "line-36",
      "statement": "Session tool activity can be inspected."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-020",
      "span": "line-40",
      "statement": "Computer use is initially disabled."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-021",
      "span": "line-40",
      "statement": "Explicit enablement is needed before its tools become available."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-022",
      "span": "line-42",
      "statement": "The active Copilot surface's permission settings determine approval behavior."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-023",
      "span": "line-42",
      "statement": "Application access may be limited to the current session."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-024",
      "span": "line-42",
      "statement": "Application approval can instead be saved for later sessions."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-025",
      "span": "line-42",
      "statement": "The user can refuse application access."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-026",
      "span": "line-44",
      "statement": "Saved application approvals are stored on the local computer."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-027",
      "span": "line-44",
      "statement": "Saved approvals are shared by the app and CLI on that computer."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-028",
      "span": "line-44",
      "statement": "The app permits inspection and removal of individual saved approvals."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-029",
      "span": "line-44",
      "statement": "Deleting a saved approval removes future-session authorization on both surfaces."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-030",
      "span": "line-44",
      "statement": "Deleting a saved approval does not revoke access already granted to an active session."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-031",
      "span": "line-46",
      "statement": "Tool-denial rules override automatic or saved approval."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-032",
      "span": "line-48",
      "statement": "Managed enterprise settings can disable computer use."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-033",
      "span": "line-48",
      "statement": "Local enablement cannot override enterprise restrictions."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-034",
      "span": "line-48",
      "statement": "The configuration reference is linked under the acquired page's own version path; that link is not a revision-verified source match."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-035",
      "span": "line-50",
      "statement": "The CLI interruption mechanism requires pressing Escape twice."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-036",
      "span": "line-50",
      "statement": "The app interruption mechanism offers Stop or Escape."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-037",
      "span": "line-54",
      "statement": "macOS Accessibility authorization permits interaction with controls."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-038",
      "span": "line-55",
      "statement": "macOS Screen Recording authorization permits visual inspection of application windows."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-039",
      "span": "line-59",
      "statement": "Interface variations across application versions, operating systems and window states can affect behavior."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-040",
      "span": "line-59",
      "statement": "Automation can select an unintended control."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-041",
      "span": "line-59",
      "statement": "Automation can write text in an unintended location."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-042",
      "span": "line-59",
      "statement": "Unusual or dynamic controls and complex workflows can impede automation."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-043",
      "span": "line-59",
      "statement": "Timing or window changes can cause different results, repeated actions or interruption."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-044",
      "span": "line-62",
      "statement": "Ambiguous instructions and unexpected visible content can cause unintended changes to devices, data or connected accounts."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-045",
      "span": "line-62",
      "statement": "Human judgment remains necessary."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-046",
      "span": "line-62",
      "statement": "Users should inspect the target application."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-047",
      "span": "line-62",
      "statement": "Users should inspect requested permissions."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-048",
      "span": "line-62",
      "statement": "Users should inspect results, particularly for data changes or effects on others."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-049",
      "span": "line-64",
      "statement": "Visible windows can expose sensitive information about the user or other people."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-050",
      "span": "line-64",
      "statement": "The user should restrict tasks to visible information they are willing to provide as model context."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-051",
      "span": "line-66",
      "statement": "Saved approval allows later control without another prompt."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-052",
      "span": "line-66",
      "statement": "Persistent approval should be avoided for sensitive or high-impact applications."
    },
    {
      "id": "PUB-COMPUTER-CONCEPT-CLOUD-053",
      "span": "line-68",
      "statement": "Responsible-use guidance is linked using this page's version-specific path; the linked page is not independently reviewed by this receipt."
    },
