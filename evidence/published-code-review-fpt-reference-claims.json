      "span": "line-119",
      "statement": "Repository-configured MCP servers may be used when relevant to reviewed code."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-060",
      "span": "line-123",
      "statement": "Skills are stored in the repository's skills directory."
    },
