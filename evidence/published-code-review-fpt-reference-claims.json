  "claims": [
    {
      "id": "PUB-CODE-REVIEW-FPT-001",
      "span": "line-7",
      "statement": "Copilot can provide review feedback and may offer directly applicable code suggestions."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-002",
      "span": "line-9",
      "statement": "The conceptual introduction link retains this acquired body's version path."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-003",
      "span": "line-11",
      "statement": "Agentic code-review capabilities use GitHub Actions."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-004",
      "span": "line-15",
      "statement": "Unlicensed organization members can receive code review when enterprise administrators or organization owners enable it."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-005",
      "span": "line-19",
      "statement": "The body contains multiple environment tabs; website instructions are only one surface."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-006",
      "span": "line-21",
      "statement": "Website review begins with a new or existing pull request."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-007",
      "span": "line-23",
      "statement": "The website sidebar offers an explicit Copilot review request."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-008",
      "span": "line-27",
      "statement": "The reported usual latency is under thirty seconds, not an execution-time guarantee."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-009",
      "span": "line-29",
      "statement": "Users are instructed to read the generated comments."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-010",
      "span": "line-33",
      "statement": "Website comments carry high, medium or low severity labels for prioritization."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-011",
      "span": "line-35",
      "statement": "The default submitted review is a comment, not approval or a change request."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-012",
      "span": "line-35",
      "statement": "Default comment reviews do not satisfy required approval counts."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-013",
      "span": "line-35",
      "statement": "Explicit configuration can enable approving Copilot reviews."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-014",
      "span": "line-39",
      "statement": "Individual suggestions can be accepted and committed."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-015",
      "span": "line-39",
      "statement": "Multiple suggestions can be accepted together in one commit."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-016",
      "span": "line-43",
      "statement": "Cloud-agent fixes require both code review and cloud agent enabled."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-017",
      "span": "line-44",
      "statement": "The fix action creates an editable draft comment for selecting feedback to address."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-018",
      "span": "line-44",
      "statement": "A fix can be directed into a new pull request against the branch."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-019",
      "span": "line-44",
      "statement": "A fix can instead be committed to the existing pull request."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-020",
      "span": "line-46",
      "statement": "Review comments permit human reactions, replies, resolution and hiding."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-021",
      "span": "line-48",
      "statement": "Human replies to review comments are not visible to Copilot."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-022",
      "span": "line-48",
      "statement": "Copilot does not answer those comment replies."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-023",
      "span": "line-50",
      "statement": "The REST review-request endpoint can select the designated Copilot reviewer bot."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-024",
      "span": "line-54",
      "statement": "Reviews are manually requested by default."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-025",
      "span": "line-54",
      "statement": "Automatic review can be separately configured."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-026",
      "span": "line-58",
      "statement": "New commits do not trigger re-review unless automatic review of new pushes is configured."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-027",
      "span": "line-60",
      "statement": "The reviewer menu provides manual re-request of review."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-028",
      "span": "line-62",
      "statement": "Automatic re-review requires automatic code review and the new-push option in ruleset settings."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-029",
      "span": "line-64",
      "statement": "Repeated reviews can repeat comments even after resolution or negative feedback."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-030",
      "span": "line-68",
      "statement": "Effort selection allows users to match review thoroughness to code criticality."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-031",
      "span": "line-70",
      "statement": "Lite targets obvious bugs, vulnerabilities and style issues with a cost-efficient review."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-032",
      "span": "line-71",
      "statement": "Balanced uses higher-reasoning analysis for complex logic, security-sensitive code and cross-service changes."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-033",
      "span": "line-73",
      "statement": "An individual pull request can choose effort before requesting review."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-034",
      "span": "line-73",
      "statement": "Users can configure a default review effort."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-035",
      "span": "line-73",
      "statement": "Organization owners or repository administrators can set automatic-review effort defaults."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-036",
      "span": "line-80",
      "statement": "Approving reviews are described as public preview subject to change."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-037",
      "span": "line-82",
      "statement": "The overview contains a readiness assessment."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-038",
      "span": "line-82",
      "statement": "A readiness assessment alone does not satisfy merge requirements."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-039",
      "span": "line-84",
      "statement": "When enabled, an approving Copilot review can satisfy a required-approval rule."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-040",
      "span": "line-84",
      "statement": "A new commit dismisses Copilot's previous approval."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-041",
      "span": "line-84",
      "statement": "Users can request another review after approval dismissal."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-042",
      "span": "line-86",
      "statement": "Approvals are initially disabled."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-043",
      "span": "line-86",
      "statement": "Approval behavior can be configured at enterprise scope."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-044",
      "span": "line-86",
      "statement": "Approval behavior can be configured at organization scope."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-045",
      "span": "line-86",
      "statement": "Approval behavior can be configured at repository scope."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-046",
      "span": "line-86",
      "statement": "Repository administrators can restrict which approvals count through file-path settings."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-047",
      "span": "line-90",
      "statement": "Repository review instructions may be repository-wide or path-specific."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-048",
      "span": "line-92",
      "statement": "The repository-wide instructions file can provide coding standards and general review criteria."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-049",
      "span": "line-94",
      "statement": "A root AGENTS file supplies contextual guidance about intentional patterns and review-sensitive areas."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-050",
      "span": "line-96",
      "statement": "Path-specific instruction files apply to matching files and can specialize language or subsystem criteria."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-051",
      "span": "line-98",
      "statement": "Additional CLAUDE, GEMINI and REVIEW instruction files are read when present."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-052",
      "span": "line-103",
      "statement": "Pull-request review reads instructions and skills from the head branch rather than the base branch."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-053",
      "span": "line-103",
      "statement": "Instruction changes can therefore be tested in the same unmerged pull request; this is not a trusted-base guarantee."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-054",
      "span": "line-110",
      "statement": "The illustrative instruction requests Spanish review output; it is not a requirement adopted by this repository."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-055",
      "span": "line-112",
      "statement": "The illustrative instruction refers to a separate security checklist, without certifying that checklist's content."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-056",
      "span": "line-114",
      "statement": "The illustrative instruction prioritizes readability."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-057",
      "span": "line-114",
      "statement": "The illustrative instruction discourages nested ternary expressions; it remains example-specific."
    },
    {
      "id": "PUB-CODE-REVIEW-FPT-058",
      "span": "line-119",
      "statement": "Repository-configured agent skills may be used when relevant to reviewed code."
    },
    {
