      "span": "line-35",
      "statement": "Interactive launch is requested through a natural-language prompt."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-009",
      "span": "line-37",
      "statement": "The registered workflow name must be specified."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-010",
      "span": "line-37",
      "statement": "Required workflow inputs must be supplied."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-011",
      "span": "line-40",
      "statement": "The security-review example includes a finite credit budget and file scope; it is inert illustrative guidance."
