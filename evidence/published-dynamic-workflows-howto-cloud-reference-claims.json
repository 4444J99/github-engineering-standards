      "id": "PUB-DYNAMIC-HOWTO-CLOUD-013",
      "span": "line-46",
      "statement": "Run approval depends on the active permission settings."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-014",
      "span": "line-48",
      "statement": "Extension-provided slash commands or canvas controls are alternate launch mechanisms."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-015",
      "span": "line-52",
      "statement": "A dedicated terminal command can launch an existing workflow."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-016",
      "span": "line-54",
      "statement": "The definition must be available through a personal extension, project extension or installed plugin."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-017",
      "span": "line-54",
      "statement": "A chat-only definition must be made available beyond its session before terminal use."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-018",
      "span": "line-56",
      "statement": "Workflow inputs can be supplied as JSON arguments."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-019",
      "span": "line-59",
      "statement": "Terminal launches do not display permission-approval prompts."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-020",
      "span": "line-59",
      "statement": "Needed permissions must be pregranted, for example as tool or URL grants."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-021",
      "span": "line-59",
      "statement": "Requests that cannot be automatically authorized are denied."
    },
    {
