      "id": "PUB-DYNAMIC-HOWTO-CLOUD-043",
      "span": "line-104",
      "statement": "Silent mode suppresses progress output."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-044",
      "span": "line-104",
      "statement": "JSON output can include workflow name, run identity, status and returned result."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-045",
      "span": "line-114",
      "statement": "Authoring defaults to a session extension but can target personal or project storage."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-046",
      "span": "line-116",
      "statement": "An authoring request should state the outcome."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-047",
      "span": "line-116",
      "statement": "An authoring request should state stage ordering."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-048",
      "span": "line-116",
      "statement": "An authoring request should identify agent-dependent steps."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-049",
      "span": "line-116",
      "statement": "An authoring request should state limits."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-050",
      "span": "line-123",
      "statement": "When no name is supplied, Copilot chooses one."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-051",
      "span": "line-125",
      "statement": "Authoring approval is governed by active permission settings."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-052",
      "span": "line-127",
      "statement": "Additional creation or registration approvals may be requested."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-053",
      "span": "line-129",
      "statement": "After authoring, users should verify registration through the available-workflow list."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-054",
      "span": "line-131",
      "statement": "Creation and registration do not launch execution."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-055",
      "span": "line-133",
      "statement": "Users can write an extension themselves with built-in guidance."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-056",
      "span": "line-143",
      "statement": "Moving an extension permits reuse or sharing of the definition."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-057",
      "span": "line-143",
      "statement": "Moving a definition does not transfer run history or saved progress."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-058",
      "span": "line-145",
      "statement": "The documented sharing process first locates the extension."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-059",
      "span": "line-153",
      "statement": "Personal extension storage provides cross-session availability."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-060",
      "span": "line-161",
      "statement": "Repository extension storage provides project sharing."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-061",
      "span": "line-169",
      "statement": "Collaborators need the merged definition in their local checkout and must load the extension."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-062",
      "span": "line-171",
      "statement": "A new or restarted session and an inventory check can verify availability, not runtime correctness."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-063",
      "span": "line-175",
      "statement": "Plugins can distribute workflows to CLI and app."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-064",
      "span": "line-179",
      "statement": "Marketplace publication permits discovery and installation; this source does not authorize publication or clear rights."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-065",
      "span": "line-183",
      "statement": "Run monitoring exposes progress and credit usage."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-066",
      "span": "line-183",
      "statement": "The interface supports reviewing completed runs."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-067",
      "span": "line-183",
      "statement": "The interface supports pausing active runs."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-068",
      "span": "line-183",
      "statement": "The interface supports canceling active runs."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-069",
      "span": "line-183",
      "statement": "Paused or limit-stopped runs may be resumed."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-070",
      "span": "line-187",
      "statement": "The interactive CLI has a workflow-list command."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-071",
      "span": "line-193",
      "statement": "Run details include active elapsed time."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-072",
      "span": "line-193",
      "statement": "Run details include any reported current phase."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-073",
      "span": "line-193",
      "statement": "Run details include active-subagent count."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-074",
      "span": "line-193",
      "statement": "Run details include total launched-subagent count."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-075",
      "span": "line-193",
      "statement": "Run details include credits consumed."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-076",
      "span": "line-195",
      "statement": "CLI controls distinguish pausing from canceling."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-077",
      "span": "line-200",
      "statement": "App run monitoring is limited to local sessions."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-078",
      "span": "line-202",
      "statement": "The app's workflow button appears when the current session contains a run."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-079",
      "span": "line-206",
      "statement": "The app popup groups active, resumable and recently finished runs."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-080",
      "span": "line-214",
      "statement": "App controls distinguish cancellation from resumable pausing."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-081",
      "span": "line-218",
      "statement": "When OpenTelemetry is enabled, each start or resume produces a workflow invocation span."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-082",
      "span": "line-218",
      "statement": "Agent trace activity is linked to that workflow span."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-083",
      "span": "line-224",
      "statement": "Only runs marked resumable can be resumed."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-084",
      "span": "line-224",
      "statement": "Saved completed-step and subagent results can be reused."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-085",
      "span": "line-224",
      "statement": "Unsaved work may need to repeat."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-086",
      "span": "line-226",
      "statement": "Resumption after a limit requires a higher cumulative allowance."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-087",
      "span": "line-226",
      "statement": "Prior usage remains charged to the resumed limit."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-088",
      "span": "line-228",
      "statement": "Canceled runs cannot be resumed."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-089",
      "span": "line-234",
      "statement": "The CLI provides a selected-run resume control."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-090",
      "span": "line-235",
      "statement": "A reached limit may need confirmation of a higher total."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-091",
      "span": "line-245",
      "statement": "The app distinguishes ordinary Resume from resumption with a raised limit."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-092",
      "span": "line-249",
      "statement": "Session scheduling commands can schedule a workflow prompt."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-093",
      "span": "line-252",
      "statement": "The scheduling example combines a recurrence, named branch and credit bound, without proving persistent scheduler execution."
    },
    {
      "id": "PUB-DYNAMIC-HOWTO-CLOUD-094",
      "span": "line-255",
      "statement": "The scheduling reference retains this body's version-qualified link."
    }
  ]
}
